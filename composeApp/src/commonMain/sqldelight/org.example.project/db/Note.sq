-- Membuat tabel Note
CREATE TABLE Note (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

-- Mengambil semua catatan
selectAll:
SELECT * FROM Note ORDER BY created_at DESC;

-- Mengambil catatan berdasarkan ID
selectById:
SELECT * FROM Note WHERE id = ?;

-- Mencari catatan (Search feature)
search:
SELECT * FROM Note WHERE title LIKE '%' || :query || '%' OR content LIKE '%' || :query || '%';

-- Menambah catatan baru
insert:
INSERT INTO Note(title, content, is_favorite, created_at)
VALUES (?, ?, ?, ?);

-- Memperbarui catatan
update:
UPDATE Note SET title = ?, content = ? WHERE id = ?;

-- Toggle status favorit
toggleFavorite:
UPDATE Note SET is_favorite = ? WHERE id = ?;

-- Menghapus catatan
delete:
DELETE FROM Note WHERE id = ?;

-- Menghapus semua catatan
deleteAll:
DELETE FROM Note;